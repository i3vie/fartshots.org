<!DOCTYPE html>
<html>

<head>
    <title>Login/Register</title>
    <link rel="stylesheet" href="/css/evie_styles.css">
</head>

<body>
    <h1>Login or Register</h1>
    <p>Use the buttons below to log in or create a new account for the i3vie section</p>

    <div id="lr-form">
        <label for="username">Username:</label>
        <input type="text" id="username" placeholder="Username" aria-label="Username"><br>
        <label for="password">Password:</label>
        <input type="password" id="password" placeholder="Password" aria-label="Password"><br>
        <br>
        <button id="login-btn" type="button">Login</button>
        <button id="register-btn" type="button">Register</button>
    </div>
    <div id="status" class="alert" hidden="true">...</div>
    <script src="/js/i3vie/login_form.js"></script>
</body>

</html>