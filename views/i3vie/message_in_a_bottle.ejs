<html>
    <head>
        <title>Message in a Bottle</title>
        <link rel="stylesheet" href="/css/evie_styles.css">
    </head>
    <body>
        <h1>Last 10 messages submitted</h1>
        <ul>
            <% messages.forEach(message => { %>
                <li><strong><%= message.author %>:</strong> <%= message.message %></li>
            <% }) %>
        </ul>

        <form action="/i3vie/message" method="post">
            <label for="message">Submit a message:</label><br>
            <input type="text" id="message" name="message"><br>
            <input type="submit" value="Submit">
        </form>
    </body>
</html>
