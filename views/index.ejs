<html>
    <head>
        <title>Home</title>
        <link rel="stylesheet" href="css/evie_styles.css">
    </head>
    <body>
        <h1>You are connected from <%= host %>. Node.js version: <%= nodeVersion %></h1>
        <h2>Using <%= useragent.browser %> on <%= useragent.os %></h2>
        <a href="https://github.com/i3vie/fartshots.org">GitHub - come contribute! Everyone is welcome!</a>
        <p class="alert info">This is an informational message.</p>
        <p class="alert warning">This is a warning message.</p>
        <p class="alert fatal">This is a fatal error message.</p>
        <p class="alert spoiler">
            <input type="checkbox" name="important_please_open" id="important_please_open" />
            <label for="important_please_open">This is an important spoiler.</label>
            <span class="content">
                <img src="img/important_please_open_do_not_be_afriad.gif" />
            </span>
        </p>
    </body>
</html>
